-- ------------------------------------------------------------
-- 3) ATUALIZA total_pedidos PARA O RANKING/HISTÓRICO
-- ------------------------------------------------------------
UPDATE clientes c
LEFT JOIN (
    SELECT cliente_id, COUNT(*) AS qtd
    FROM pedidos
    WHERE cliente_id IS NOT NULL
    GROUP BY cliente_id
) p ON p.cliente_id = c.id
SET c.total_pedidos = COALESCE(p.qtd, 0)
WHERE c.telefone_chave LIKE '6198%';

COMMIT;

-- ------------------------------------------------------------
-- CONSULTAS DE CONFERÊNCIA
-- ------------------------------------------------------------

-- Quantos clientes sintéticos foram inseridos:
SELECT COUNT(*) AS clientes_simulados
FROM clientes
WHERE telefone_chave LIKE '6198%';

-- Quantos pedidos simulados:
SELECT COUNT(*) AS pedidos_simulados
FROM pedidos
WHERE observacoes = 'DADOS_SIMULADOS_PORTFOLIO';

-- Ranking dos 20 clientes que mais compraram:
SELECT
    c.id,
    c.nome,
    c.telefone,
    c.total_pedidos,
    SUM(p.total_itens) AS itens_comprados,
    SUM(p.valor_total) AS valor_gasto
FROM clientes c
JOIN pedidos p ON p.cliente_id = c.id
WHERE p.observacoes = 'DADOS_SIMULADOS_PORTFOLIO'
GROUP BY c.id, c.nome, c.telefone, c.total_pedidos
ORDER BY c.total_pedidos DESC, valor_gasto DESC
LIMIT 20;

-- Ranking de sabores:
SELECT
    pr.nome AS sabor,
    SUM(pi.quantidade) AS unidades_vendidas
FROM pedido_itens pi
JOIN pedidos p ON p.id = pi.pedido_id
JOIN produtos pr ON pr.id = pi.produto_id
WHERE p.observacoes = 'DADOS_SIMULADOS_PORTFOLIO'
GROUP BY pr.id, pr.nome
ORDER BY unidades_vendidas DESC;

-- Média de pedidos por dia da semana:
SELECT
    DAYNAME(data_retirada) AS dia_semana,
    COUNT(*) AS pedidos
FROM pedidos
WHERE observacoes = 'DADOS_SIMULADOS_PORTFOLIO'
GROUP BY DAYOFWEEK(data_retirada), DAYNAME(data_retirada)
ORDER BY DAYOFWEEK(data_retirada);
