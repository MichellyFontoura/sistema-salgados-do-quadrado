            st.info("Nenhum cliente cadastrado ainda.")

    st.write("")

    with st.container(border=True):
        st.markdown('<div class="sec">Editar cadastro de cliente</div>', unsafe_allow_html=True)
        if st.session_state.customers:
            st.caption(
                "Errou um número, o cliente trocou de telefone ou perdeu o antigo? "
                "Selecione o cadastro e corrija aqui."
            )
            chaves = list(st.session_state.customers.keys())
            rotulos = {
                k: f"{st.session_state.customers[k]['nome']} · {st.session_state.customers[k]['telefone']}"
                for k in chaves
            }
            chave_sel = st.selectbox(
                "Cliente",
                chaves,
                format_func=lambda k: rotulos.get(k, k),
                key="edit_cliente_sel",
            )
            c_atual = st.session_state.customers[chave_sel]

            # chaves de widget únicas por cliente, para não misturar dados
            # ao trocar a seleção e para permitir a máscara em tempo real
            k_nome = f"edit_nome_{chave_sel}"
            k_tel = f"edit_tel_{chave_sel}"
            k_emp = f"edit_empresa_{chave_sel}"
            k_cnpj = f"edit_cnpj_{chave_sel}"
            k_sexo = f"edit_sexo_{chave_sel}"
            k_end = f"edit_endereco_{chave_sel}"

            if k_tel not in st.session_state:
                st.session_state[k_tel] = mask_phone(c_atual.get("telefone", ""))
            if k_cnpj not in st.session_state:
                st.session_state[k_cnpj] = mask_cnpj(c_atual.get("cnpj", ""))

            e1, e2 = st.columns(2)
            novo_nome = e1.text_input("Nome", value=c_atual.get("nome", ""), key=k_nome)
            novo_telefone = e2.text_input(
                "Telefone (WhatsApp)",
                key=k_tel,
                on_change=_aplicar_mascara_telefone,
                args=(k_tel,),
            )

            nova_empresa = st.checkbox("Empresa", value=bool(c_atual.get("empresa", False)), key=k_emp)
            if nova_empresa:
                novo_cnpj = st.text_input(
                    "CNPJ (opcional)",
                    key=k_cnpj,
                    on_change=_aplicar_mascara_cnpj,
                    args=(k_cnpj,),
                )
                novo_sexo = c_atual.get("sexo", "N/A")
            else:
                novo_cnpj = ""
                opcoes_sexo_edit = ["Não informado", "Feminino", "Masculino"]
                novo_sexo = st.selectbox(
                    "Sexo",
                    opcoes_sexo_edit,
                    index=opcoes_sexo_edit.index(c_atual.get("sexo", "Não informado"))
                    if c_atual.get("sexo") in opcoes_sexo_edit
                    else 0,
                    key=k_sexo,
                )
            novo_endereco = st.text_input(
                "Endereço", value=c_atual.get("endereco", "N/A"), key=k_end
            )

            if st.button("Salvar alterações", type="primary", key=f"salvar_{chave_sel}"):
                nova_chave = normalize_phone(novo_telefone)
                if not novo_nome.strip():
                    st.error("Informe o nome do cliente.")
                elif len(nova_chave) < 10:
                    st.error("Informe um telefone válido com DDD.")
                elif nova_chave != chave_sel and nova_chave in st.session_state.customers:
                    st.error(
                        "Já existe outro cliente cadastrado com esse telefone. "
                        "Não é possível salvar."
                    )
                else:
                    atualizado = dict(c_atual)
                    atualizado.update(
                        {
                            "nome": novo_nome.strip(),
                            "telefone": novo_telefone.strip(),
                            "empresa": nova_empresa,
                            "cnpj": novo_cnpj.strip() if nova_empresa else "",
                            "sexo": novo_sexo if not nova_empresa else "N/A",
                            "endereco": novo_endereco,
                        }
                    )
                    if nova_chave != chave_sel:
                        del st.session_state.customers[chave_sel]
                        st.session_state.pop("edit_cliente_sel", None)
                    st.session_state.customers[nova_chave] = atualizado
                    salvar()
                    st.success("Cadastro atualizado.")
                    st.rerun()
        else:
            st.info("Cadastre um cliente para poder editá-lo aqui.")

    st.write("")

    with st.container(border=True):
        st.markdown('<div class="sec">Histórico de pedidos</div>', unsafe_allow_html=True)
        if st.session_state.orders:
            odf = pd.DataFrame(st.session_state.orders)[::-1]
            if "Valor" in odf.columns:
                odf["Valor"] = odf["Valor"].fillna(0).map(brl)
            st.dataframe(odf, use_container_width=True, hide_index=True)
            st.markdown('<div class="sec">Itens por canal</div>', unsafe_allow_html=True)
            st.bar_chart(odf.groupby("Canal")["Total Itens"].sum(), color="#e98a00", height=240)
        else:
            st.info("Nenhum pedido registrado ainda.")
