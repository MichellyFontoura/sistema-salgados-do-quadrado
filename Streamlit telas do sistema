def para_int(valor) -> int:
    """Converte valores numéricos para inteiro com segurança."""
    try:
        return int(float(str(valor).replace(",", ".").strip()))
    except (TypeError, ValueError):
        return 0


def para_float(valor) -> float:
    """Converte valores numéricos para float com segurança."""
    try:
        return float(str(valor).replace(",", ".").strip())
    except (TypeError, ValueError):
        return 0.0

def estado_inicial():
    return {
        "stock": {nome: p["inicial"] for nome, p in PRODUCTS.items()},
        "customers": {},
        "orders": [],
        "prices": dict(PRECOS_PADRAO),
    }


def conectar_mysql():
    """
    Abre uma conexão com o banco.
    As credenciais ficam em .streamlit/secrets.toml.
    """
    try:
        cfg = st.secrets["mysql"]
        return mysql.connector.connect(
            host=cfg.get("host", "localhost"),
            port=int(cfg.get("port", 3306)),
            user=cfg.get("user", "root"),
            password=cfg.get("password", ""),
            database=cfg.get("database", "salgados_do_quadrado"),
            charset="utf8mb4",
            autocommit=False,
        )
    except Exception as exc:
        raise RuntimeError(
            "Não foi possível conectar ao MySQL. "
            f"Detalhe técnico: {exc}"
        ) from exc


def _data_br_para_date(valor):
    if not valor:
        return datetime.now().date()
    if hasattr(valor, "year") and not isinstance(valor, str):
        return valor
    return datetime.strptime(str(valor), "%d/%m/%Y").date()


def _registro_para_datetime(valor):
    if not valor:
        return datetime.now()
    if isinstance(valor, datetime):
        return valor
    return datetime.strptime(str(valor), "%d/%m/%Y %H:%M")


def _retirada_para_data_hora(valor):
    texto = str(valor or "").strip()
    if " às " in texto:
        d, h = texto.split(" às ", 1)
        return (
            datetime.strptime(d, "%d/%m/%Y").date(),
            datetime.strptime(h, "%H:%M").time(),
        )
    agora = datetime.now()
    return agora.date(), agora.time().replace(second=0, microsecond=0)


import re


def _itens_do_texto(texto):
    """
    Converte '25x Coxinha, 25x Kibe' em [('Coxinha', 25), ('Kibe', 25)].
    """
    encontrados = re.findall(r"(\d+)x\s+(.+?)(?=,\s+\d+x\s+|$)", str(texto or ""))
    return [(nome.strip(), int(qtd)) for qtd, nome in encontrados]


def carregar():
    """Carrega produtos, clientes, pedidos e itens diretamente do MySQL."""
    base = estado_inicial()
    con = conectar_mysql()
    cur = con.cursor(dictionary=True)

    try:
        cur.execute(
            "SELECT id, nome, tipo, preco, estoque, estoque_minimo "
            "FROM produtos WHERE ativo = 1 ORDER BY id"
        )
        produtos_db = cur.fetchall()
        for p in produtos_db:
            nome = p["nome"]
            if nome in base["stock"]:
                base["stock"][nome] = int(p["estoque"])
                base["prices"][nome] = float(p["preco"])

        # A quantidade de pedidos é calculada diretamente da tabela `pedidos`.
        # Assim o sistema não depende de `clientes.total_pedidos` estar atualizado.
        cur.execute(
            """
            SELECT
                c.id, c.telefone_chave, c.telefone, c.nome, c.empresa,
                c.cnpj, c.sexo, c.endereco, c.total_pedidos, c.cadastrado_em,
                COALESCE(COUNT(p.id), 0) AS pedidos_reais
            FROM clientes c
            LEFT JOIN pedidos p ON p.cliente_id = c.id
            GROUP BY
                c.id, c.telefone_chave, c.telefone, c.nome, c.empresa,
                c.cnpj, c.sexo, c.endereco, c.total_pedidos, c.cadastrado_em
            ORDER BY c.id
            """
        )
        for c in cur.fetchall():
            chave = c["telefone_chave"]
            base["customers"][chave] = {
                "_db_id": int(c["id"]),
                "nome": c["nome"],
                "telefone": c["telefone"],
                "empresa": bool(c["empresa"]),
                "cnpj": c["cnpj"] or "",
                "sexo": c["sexo"],
                "endereco": c["endereco"] or "N/A",
                # Usa a contagem real existente em `pedidos`.
                "pedidos": int(c["pedidos_reais"] or 0),
                "cadastrado_em": c["cadastrado_em"].strftime("%d/%m/%Y"),
            }

        cur.execute(
            """
            SELECT
                p.id, p.canal, p.codigo_ifood, p.nome_cliente, p.telefone,
                p.data_retirada, p.hora_retirada, p.endereco,
                p.forma_pagamento, p.total_itens, p.valor_total,
                p.observacoes, p.registrado_em
            FROM pedidos p
            ORDER BY p.registrado_em, p.id
            """
        )
        pedidos_db = cur.fetchall()

        if pedidos_db:
            ids = [str(int(p["id"])) for p in pedidos_db]
            placeholders = ",".join(["%s"] * len(ids))
            cur.execute(
                f"""
                SELECT pi.pedido_id, pr.nome, pi.quantidade
                FROM pedido_itens pi
                JOIN produtos pr ON pr.id = pi.produto_id
                WHERE pi.pedido_id IN ({placeholders})
                ORDER BY pi.id
                """,
                ids,
            )
            itens_por_pedido = {}
            for item in cur.fetchall():
                itens_por_pedido.setdefault(int(item["pedido_id"]), []).append(
                    (item["nome"], int(item["quantidade"]))
                )
        else:
            itens_por_pedido = {}

        for p in pedidos_db:
            pid = int(p["id"])
            itens = itens_por_pedido.get(pid, [])
            canal_app = "WhatsApp / Direto" if p["canal"] == "WhatsApp/Direto" else "iFood"
            base["orders"].append(
                {
                    "_db_id": pid,
                    "Registro": p["registrado_em"].strftime("%d/%m/%Y %H:%M"),
                    "Canal": canal_app,
                    "Cliente": p["nome_cliente"],
                    "Telefone": p["telefone"] or "",
                    "Código iFood": p["codigo_ifood"] or "",
                    "Retirada": (
                        f"{p['data_retirada'].strftime('%d/%m/%Y')} "
                        f"às {str(p['hora_retirada'])[:5]}"
                    ),
                    "Endereço": p["endereco"],
                    "Total Itens": int(p["total_itens"] or 0),
                    "Valor": float(p["valor_total"] or 0),
                    "Itens": ", ".join(f"{q}x {n}" for n, q in itens),
                    "Pagamento": p["forma_pagamento"],
                    "Obs": p["observacoes"] or "",
                }
            )
        return base
    finally:
        cur.close()
        con.close()


def salvar():
    """
    Sincroniza o estado atual da tela com o MySQL.
    Produtos/clientes são atualizados; apenas pedidos ainda sem _db_id são inseridos.
    """
    con = conectar_mysql()
    cur = con.cursor(dictionary=True)

    try:
        # 1) Estoque e preços
        for nome in PRODUCTS:
            cur.execute(
                "UPDATE produtos SET estoque=%s, preco=%s WHERE nome=%s",
                (
                    int(st.session_state.stock.get(nome, 0)),
                    float(st.session_state.prices.get(nome, 0)),
                    nome,
                ),
            )

        # 2) Clientes
        for tel_key, cliente in st.session_state.customers.items():
            cadastrado_em = _data_br_para_date(cliente.get("cadastrado_em"))
            db_id = cliente.get("_db_id")

            valores = (
                tel_key,
                cliente.get("telefone", ""),
                cliente.get("nome", ""),
                1 if cliente.get("empresa") else 0,
                cliente.get("cnpj") or None,
                cliente.get("sexo", "Não informado"),
                cliente.get("endereco") or "N/A",
                int(cliente.get("pedidos", 0)),
                cadastrado_em,
            )

            if db_id:
                cur.execute(
                    """
                    UPDATE clientes
                    SET telefone_chave=%s, telefone=%s, nome=%s, empresa=%s,
                        cnpj=%s, sexo=%s, endereco=%s, total_pedidos=%s,
                        cadastrado_em=%s
                    WHERE id=%s
                    """,
                    valores + (int(db_id),),
                )
            else:
                cur.execute(
                    """
                    INSERT INTO clientes
                    (telefone_chave, telefone, nome, empresa, cnpj, sexo,
                     endereco, total_pedidos, cadastrado_em)
                    VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s)
                    ON DUPLICATE KEY UPDATE
                        telefone=VALUES(telefone),
                        nome=VALUES(nome),
                        empresa=VALUES(empresa),
                        cnpj=VALUES(cnpj),
                        sexo=VALUES(sexo),
                        endereco=VALUES(endereco),
                        total_pedidos=VALUES(total_pedidos)
                    """,
                    valores,
                )
                cur.execute(
                    "SELECT id FROM clientes WHERE telefone_chave=%s",
                    (tel_key,),
                )
                achado = cur.fetchone()
                if achado:
                    cliente["_db_id"] = int(achado["id"])

        # 3) Novos pedidos
        for pedido in st.session_state.orders:
            if pedido.get("_db_id"):
                continue

            canal_app = pedido.get("Canal", "")
            canal_db = "WhatsApp/Direto" if canal_app == "WhatsApp / Direto" else "iFood"

            cliente_id = None
            if canal_db == "WhatsApp/Direto":
                chave = "".join(filter(str.isdigit, pedido.get("Telefone", "") or ""))
                cliente = st.session_state.customers.get(chave)
                if cliente:
                    cliente_id = cliente.get("_db_id")

            data_ret, hora_ret = _retirada_para_data_hora(pedido.get("Retirada"))
            endereco = pedido.get("Endereço") or "Retirada no local"
            entrega = 0 if endereco == "Retirada no local" else 1
            codigo_ifood = (pedido.get("Código iFood") or "").strip() or None

            cur.execute(
                """
                INSERT INTO pedidos
                (cliente_id, canal, codigo_ifood, nome_cliente, telefone,
                 data_retirada, hora_retirada, entrega, endereco,
                 forma_pagamento, total_itens, valor_total, observacoes,
                 registrado_em)
                VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)
                """,
                (
                    cliente_id,
                    canal_db,
                    codigo_ifood,
                    pedido.get("Cliente") or "",
                    (pedido.get("Telefone") or None),
                    data_ret,
                    hora_ret,
                    entrega,
                    endereco,
                    pedido.get("Pagamento") or "Pix",
                    int(pedido.get("Total Itens", 0)),
                    float(pedido.get("Valor", 0)),
                    (pedido.get("Obs") or None),
                    _registro_para_datetime(pedido.get("Registro")),
                ),
            )
            pedido_id = int(cur.lastrowid)

            for nome_produto, qtd in _itens_do_texto(pedido.get("Itens")):
                cur.execute(
                    "SELECT id, preco FROM produtos WHERE nome=%s",
                    (nome_produto,),
                )
                prod = cur.fetchone()
                if not prod:
                    raise RuntimeError(f"Produto não encontrado no MySQL: {nome_produto}")

                cur.execute(
                    """
                    INSERT INTO pedido_itens
                    (pedido_id, produto_id, quantidade, preco_unitario)
                    VALUES (%s,%s,%s,%s)
                    """,
                    (
                        pedido_id,
                        int(prod["id"]),
                        int(qtd),
                        float(st.session_state.prices.get(nome_produto, prod["preco"])),
                    ),
                )

            pedido["_db_id"] = pedido_id

            # Mantém `clientes.total_pedidos` sincronizado sem depender de
            # UPDATE em massa. O WHERE usa a chave primária (`id`), portanto
            # também é seguro no MySQL Workbench com Safe Updates ativado.
            if cliente_id is not None:
                cur.execute(
                    "SELECT COUNT(*) AS qtd FROM pedidos WHERE cliente_id=%s",
                    (int(cliente_id),),
                )
                qtd_real = int(cur.fetchone()["qtd"] or 0)
                cur.execute(
                    "UPDATE clientes SET total_pedidos=%s WHERE id=%s",
                    (qtd_real, int(cliente_id)),
                )

                chave = "".join(filter(str.isdigit, pedido.get("Telefone", "") or ""))
                cliente_sessao = st.session_state.customers.get(chave)
                if cliente_sessao is not None:
                    cliente_sessao["pedidos"] = qtd_real

        con.commit()

    except Exception:
        con.rollback()
        raise
    finally:
        cur.close()
        con.close()


if "carregado" not in st.session_state:
    try:
        dados = carregar()
    except Exception as exc:
        st.error(f"Erro ao conectar/carregar o MySQL: {exc}")
        st.info(
            "Verifique se o MySQL está iniciado, se o banco salgados_do_quadrado "
            "foi criado e se o arquivo .streamlit/secrets.toml está correto."
        )
        st.stop()

    st.session_state.stock = dados["stock"]
    st.session_state.customers = dados["customers"]
    st.session_state.orders = dados["orders"]
    st.session_state.prices = dados["prices"]
    st.session_state.carregado = True


def normalize_phone(phone: str) -> str:
    return "".join(filter(str.isdigit, phone or ""))


def mask_phone(raw: str) -> str:
    """Formata como (DD) 9XXXX-XXXX (celular) ou (DD) XXXX-XXXX (fixo), conforme digita."""
    d = normalize_phone(raw)[:11]
    if len(d) > 10:
        return f"({d[:2]}) {d[2:7]}-{d[7:]}"
    if len(d) > 6:
        return f"({d[:2]}) {d[2:6]}-{d[6:]}"
    if len(d) > 2:
        return f"({d[:2]}) {d[2:]}"
    if d:
        return f"({d}"
    return ""


def normalize_cnpj(cnpj: str) -> str:
    return "".join(filter(str.isdigit, cnpj or ""))


def mask_cnpj(raw: str) -> str:
    """Formata como XX.XXX.XXX/XXXX-XX, conforme digita."""
    d = normalize_cnpj(raw)[:14]
    if len(d) > 12:
        return f"{d[:2]}.{d[2:5]}.{d[5:8]}/{d[8:12]}-{d[12:]}"
    if len(d) > 8:
        return f"{d[:2]}.{d[2:5]}.{d[5:8]}/{d[8:]}"
    if len(d) > 5:
        return f"{d[:2]}.{d[2:5]}.{d[5:]}"
    if len(d) > 2:
        return f"{d[:2]}.{d[2:]}"
    return d


def _aplicar_mascara_telefone(key: str):
    st.session_state[key] = mask_phone(st.session_state[key])


def _aplicar_mascara_cnpj(key: str):
    st.session_state[key] = mask_cnpj(st.session_state[key])


def brl(valor: float) -> str:
    return f"R$ {valor:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")


def preco(nome: str) -> float:
    return float(st.session_state.prices.get(nome, PRECOS_PADRAO.get(nome, 0.0)))


def valor_pedido(pedido: dict) -> float:
    return float(pedido.get("Valor", 0) or 0)


def faturamento_por_dia() -> pd.DataFrame:
    """Agrupa o valor dos pedidos pela data de registro (dd/mm/aaaa)."""
    if not st.session_state.orders:
        return pd.DataFrame(columns=["Dia", "Faturamento", "Pedidos", "Itens"])

    linhas = []
    for o in st.session_state.orders:
        dia = str(o.get("Registro", ""))[:10]
        linhas.append(
            {
                "Dia": dia,
                "Faturamento": valor_pedido(o),
                "Pedidos": 1,
                "Itens": o.get("Total Itens", 0),
            }
        )
    df = pd.DataFrame(linhas)
    df = df.groupby("Dia", as_index=False).sum()
    df["ordem"] = pd.to_datetime(df["Dia"], format="%d/%m/%Y", errors="coerce")
    return df.sort_values("ordem").drop(columns="ordem")


def baixo_estoque():
    return [
        n for n, q in st.session_state.stock.items() if para_int(q) <= PRODUCTS[n]["minimo"]
    ]


